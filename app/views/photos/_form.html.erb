<%= form_with(model: photo, local: true, html: { multipart: true, class: "space-y-4" }) do |form| %>
  <div>
    <%= form.label :title, class: "block font-bold" %>
    <%= form.text_field :title, class: "w-full border rounded px-3 py-2" %>
  </div>

  <div>
    <%= form.label :description, class: "block font-bold" %>
    <%= form.text_area :description, class: "w-full border rounded px-3 py-2" %>
  </div>

  <div>
    <%= form.label :images, "Upload Images", class: "block font-bold" %>
    <%= form.file_field :images, multiple: true, class: "w-full" %>
  </div>


  <%= form.submit class: "bg-green-600 text-white px-4 py-2 rounded" %>
<% end %>
