<h1 class="text-2xl font-bold mb-4">📸 Photo Feed</h1>

<%= link_to 'Upload New Photo', new_photo_path, class: "bg-indigo-600 text-white px-4 py-2 rounded mb-4 inline-block" if user_signed_in? %>


<% if @photos.any? %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <% @photos.each_slice((@photos.size / 4.0).ceil).each do |column| %>
      <div class="grid gap-4">
        <% column.each do |photo| %>
          <div>
            <%= link_to photo_path(photo) do %>
              <%= image_tag photo.images.first.variant(resize_to_limit: [600, nil]), 
                            class: "w-full rounded-xl shadow hover:opacity-90 transition", 
                            alt: photo.title, 
                            loading: "lazy" if photo.images.attached? %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-gray-500">No photos uploaded yet.</p>
<% end %>
