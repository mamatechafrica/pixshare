<h1 class="text-2xl font-bold"><%= @photo.title %></h1>
<p class="text-gray-600 mb-2"><%= @photo.description %></p>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
  <% @photo.images.each do |image| %>
    <%= image_tag image.variant(resize_to_limit: [800, 600]), class: "rounded w-full h-auto" %>
  <% end %>
</div>


<hr class="my-6">

<h2 class="text-xl font-bold mb-2">💬 Comments</h2>

<%= render 'comments/form', photo: @photo, comment: @comment %>

<% @comments.each do |comment| %>
  <div class="bg-gray-100 p-3 rounded mb-2">
    <strong><%= comment.user.email %></strong>: <%= comment.content %>
  </div>
<% end %>
