<div class="min-h-screen bg-gradient-to-br from-blue-50 via-purple-50 to-pink-50 flex items-center justify-center relative overflow-hidden">
  <!-- Background Image with proper responsive handling -->
  <div class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-20" style="background-image: url('<%= asset_path('RomaniaCover.JPG') %>');">
  </div>
  
  <!-- Overlay for better text visibility -->
  <div class="absolute inset-0 bg-gradient-to-br from-blue-900/10 to-purple-900/10"></div>
  
  <!-- Main Content -->
  <div class="relative z-10 text-center px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <!-- Logo -->
    <div class="mb-8">
      <%= link_to root_path, class: "inline-block" do %>
        <%= image_tag('ps-logo.png', alt: 'Pix Share Logo', 
            class: 'h-32 w-auto sm:h-40 md:h-48 lg:h-56 mx-auto drop-shadow-lg hover:scale-105 transition-transform duration-300') %>
      <% end %>
    </div>
    
    <!-- Welcome Text -->
    <div class="mb-12">
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-gray-800 mb-6 leading-tight">
        Welcome to <span class="bg-gradient-to-r from-purple-600 to-blue-600 bg-clip-text text-transparent">PixShare</span>
      </h1>
      <p class="text-lg sm:text-xl md:text-2xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
        Share your moments, memories, and creativity with the world. Connect with others through the power of visual storytelling.
      </p>
    </div>
    
    <!-- Call to Action Buttons -->
    <% unless user_signed_in? %>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <%= link_to "Get Started", new_user_registration_path, 
            class: "w-full sm:w-auto bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 text-white font-semibold px-8 py-4 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1" %>
        <%= link_to "Sign In", new_user_session_path, 
            class: "w-full sm:w-auto bg-white hover:bg-gray-50 text-gray-800 font-semibold px-8 py-4 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-200" %>
      </div>
    <% else %>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <%= link_to "View Your Photos", photos_path(user_id: current_user.id), 
            class: "w-full sm:w-auto bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 text-white font-semibold px-8 py-4 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1" %>
        <%= link_to "Upload New Photo", new_photo_path, 
            class: "w-full sm:w-auto bg-white hover:bg-gray-50 text-gray-800 font-semibold px-8 py-4 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-200" %>
      </div>
    <% end %>
    
    <!-- Feature highlights -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      <div class="bg-white/80 backdrop-blur-sm rounded-lg p-6 shadow-lg">
        <div class="text-3xl mb-4">📸</div>
        <h3 class="text-xl font-semibold text-gray-800 mb-2">Share Photos</h3>
        <p class="text-gray-600">Upload and share your favorite moments with friends and family</p>
      </div>
      <div class="bg-white/80 backdrop-blur-sm rounded-lg p-6 shadow-lg">
        <div class="text-3xl mb-4">💬</div>
        <h3 class="text-xl font-semibold text-gray-800 mb-2">Connect</h3>
        <p class="text-gray-600">Comment and interact with photos from your community</p>
      </div>
      <div class="bg-white/80 backdrop-blur-sm rounded-lg p-6 shadow-lg">
        <div class="text-3xl mb-4">🔍</div>
        <h3 class="text-xl font-semibold text-gray-800 mb-2">Discover</h3>
        <p class="text-gray-600">Explore and discover amazing photography from around the world</p>
      </div>
    </div>
  </div>
  
  <!-- Floating decorative elements -->
  <div class="absolute top-1/4 left-1/4 w-4 h-4 bg-purple-300 rounded-full opacity-60 animate-pulse"></div>
  <div class="absolute top-3/4 right-1/4 w-6 h-6 bg-blue-300 rounded-full opacity-40 animate-pulse delay-1000"></div>
  <div class="absolute bottom-1/4 left-1/3 w-3 h-3 bg-pink-300 rounded-full opacity-50 animate-pulse delay-500"></div>
</div>
