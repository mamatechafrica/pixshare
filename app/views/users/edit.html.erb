<div class="max-w-xl mx-auto px-4 py-8">
  <h2 class="text-2xl font-semibold mb-6 text-center">Edit Profile</h2>

  <%= form_with model: @user, local: true, html: { multipart: true }, class: "space-y-6" do |f| %>
    <div>
      <%= f.label :name, class: "block font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full border border-gray-300 rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
    </div>

    <div>
      <%= f.label :bio, class: "block font-semibold text-gray-700 mb-1" %>
      <%= f.text_area :bio, rows: 3, class: "w-full border border-gray-300 rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
    </div>

    <div>
      <%= f.label :avatar, class: "block font-semibold text-gray-700 mb-1" %>
      <%= f.file_field :avatar, accept: "image/*", class: "block w-full text-gray-700", onchange: "previewAvatar(event)" %>

      <div class="mt-4">
        <p class="font-medium text-gray-700 mb-1">Preview:</p>
        <img id="avatar-preview" src="<%= url_for(@user.avatar) if @user.avatar.attached? %>" class="rounded shadow w-24 h-24 object-cover" />
      </div>
    </div>

    <div class="text-center">
      <%= f.submit "Update Profile", class: "bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700" %>
    </div>
  <% end %>
</div>

<script>
  function previewAvatar(event) {
    const input = event.target;
    const preview = document.getElementById('avatar-preview');

    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        preview.src = e.target.result;
      };
      reader.readAsDataURL(input.files[0]);
    }
  }
</script>
