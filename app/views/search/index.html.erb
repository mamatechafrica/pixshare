<h1 class="text-xl font-bold mb-4">🔍 Search Results</h1>

<%= form_with(url: search_index_path, method: :get, local: true) do |form| %>
  <%= form.text_field :query, placeholder: "Search photos...", class: "border px-3 py-2 rounded w-full mb-4" %>
<% end %>

<% if @photos.any? %>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
    <% @photos.each do |photo| %>
      <div class="bg-white rounded shadow-md p-4">
        <%= link_to image_tag(photo.images.first.variant(resize_to_limit: [300, 200]), class: "rounded"), photo_path(photo) %>
        <p class="font-bold mt-2"><%= link_to photo.title, photo_path(photo) %></p>
      </div>
    <% end %>
  </div>
<% else %>
  <p>No results found.</p>
<% end %>
