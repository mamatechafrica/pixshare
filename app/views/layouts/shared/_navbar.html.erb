<nav class="bg-white shadow-md mb-4 w-full">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    <!-- Left: Logo -->
    <%= link_to root_path do %>
      <%= image_tag("ps-logo.png", alt: "Pix Share", class: "h-14 w-auto") %>
    <% end %>

    <!-- Right: Nav Links -->
    <div class="flex items-center space-x-4">
      <% if user_signed_in? %>
        <%= link_to "Photos", photos_path(user_id: current_user.id), class: "text-gray-700 hover:text-purple-600 font-medium" %>


        <%= link_to "Profile", user_path(current_user), class: "text-gray-700 hover:text-blue-600 font-medium" %>
        <%= link_to "Logout", destroy_user_session_path, method: :delete, class: "text-gray-700 hover:text-red-600 font-medium" %>
      <% else %>
        <%= link_to "Sign Up", new_user_registration_path, class: "text-gray-700 hover:text-green-600 font-medium" %>
        <%= link_to "Login", new_user_session_path, class: "text-gray-700 hover:text-blue-600 font-medium" %>
      <% end %>
    </div>
  </div>
</nav>
