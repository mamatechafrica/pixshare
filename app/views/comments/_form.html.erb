<%= form_with(model: [photo, comment], local: true) do |form| %>
  <div class="mb-2">
    <%= form.label :content, "Add a comment", class: "block font-bold" %>
    <%= form.text_area :content, rows: 2, class: "w-full border rounded px-3 py-2" %>
  </div>
  <%= form.submit "Comment", class: "bg-blue-600 text-white px-4 py-2 rounded" %>
<% end %>
